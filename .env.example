# Google Cloud OAuth client (Gmail send + Drive read + Forms responses read
# scopes enabled), same Workspace identity as the sibling automations
# (julienne@myadventuregroup.com.au). IMPORTANT: this must be a token that was
# actually consented with forms.responses.readonly — see the note in
# config.py above GOOGLE_SCOPES. Do not assume any given "shared" token has
# this scope without checking; verify via oauth2.googleapis.com/token first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated by oauth_setup.py after completing the consent flow once
# (only needed for local testing with a fresh token)
GOOGLE_REFRESH_TOKEN=

# Anthropic API key (console.anthropic.com) - used by src/classifier_service.py.
# NOT named ANTHROPIC_API_KEY on purpose: on claude.ai cloud environments that
# exact name is reserved for the Claude Code session's own account-based auth
# and is never actually injected into the process environment, even if set in
# the environment's variable UI. Use this name everywhere instead.
CLASSIFIER_ANTHROPIC_API_KEY=

# Supabase project used for the proposal_router_logs dedup/audit table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bearer tokens for firing each downstream pipeline's routine directly via
# its bound-session HTTP fire endpoint (src/trigger_fire_service.py) — each
# minted separately via the claude.ai UI, one per routine, NOT the same as
# any key above. Optional: if unset for a given type, that type's downstream
# routine just isn't fired immediately — it still gets processed on its own
# next hourly cron, since the forwarded email was already sent regardless.
FIRE_TOKEN_UNCHARTED_ICE=
FIRE_TOKEN_KEYNOTE=
FIRE_TOKEN_INTERACTIVE_KEYNOTE=
